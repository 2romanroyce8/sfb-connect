{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sfb-connect",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://sfbconnect.com",
    "NEXT_PUBLIC_CASHAPP_TAG": "$SFBConnect",
    "NEXT_PUBLIC_PAYPAL_CONTACT": "paypal.me/SFBConnect",
    "NEXT_PUBLIC_ZELLE_CONTACT": "payments@sfbconnect.com"
  }
  // Secrets (Supabase service role key, Resend key, etc.) are NOT set here.
  // Set them via:
  //   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  // or in the Cloudflare Pages/Workers dashboard under Settings > Variables.
}
