# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payment contacts — shown to customers on /pay as where to send money.
# Cash App and Zelle have no merchant API, so payments are manually
# confirmed by an admin in /admin/payments against these actual accounts.
NEXT_PUBLIC_CASHAPP_TAG=$SFBConnect
NEXT_PUBLIC_PAYPAL_CONTACT=paypal.me/SFBConnect
NEXT_PUBLIC_ZELLE_CONTACT=payments@sfbconnect.com

# Resend (transactional email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=SFB Connect <hello@sfbconnect.com>

# App
NEXT_PUBLIC_APP_URL=https://sfbconnect.com
ADMIN_EMAIL_ALLOWLIST=you@sfbconnect.com,partner@sfbconnect.com
