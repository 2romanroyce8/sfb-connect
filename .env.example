# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payment contacts — shown to customers on /pay as where to send money.
# Cash App and Zelle have no merchant API, so payments are manually
# confirmed by an admin in /admin/payments against these actual accounts.

# Resend (transactional email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=SFB Connect <hello@sfbconnect.com>

# App
NEXT_PUBLIC_APP_URL=https://sfbconnect.com

# ---- Added 2026-10-10 inventory (names only; values live in Vercel) ----
# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Encryption for stored OAuth tokens / delegated sessions
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Cron fallback bearer (pg_cron uses Vault tokens; this is optional)
CRON_SECRET=
# Research / discovery providers
EXA_API_KEY=
SERP_API_KEY=
BING_SEARCH_API_KEY=
# AI visibility engine (optional)
AI_VISIBILITY_ENGINE_ENABLED=
AI_VISIBILITY_MAX_CHECKS_PER_SCAN=
AI_VISIBILITY_MAX_SPEND_CENTS_PER_SCAN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
# 7-day analyzer: Reviews row (optional)
GOOGLE_PLACES_API_KEY=
# Transactional email (system service)
# OAuth integrations (register redirect https://www.sfbconnect.com/api/team/integrations/<key>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

